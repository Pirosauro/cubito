      &lt;p class=&quot;multiselect__status&quot; aria-live=&quot;polite&quot;&gt;&lt;/p&gt;
    &lt;/fieldset&gt;
  &lt;/details&gt;</code></pre>
      </details>

    </div>
  </section>

  <section>
    <div class="flow" style="--flow-space: var(--space-s);">
      <h2 class="heading-l">Inline panel</h2>
      <p>Add <code>data-variant="inline"</code> to keep the panel in the document flow instead of floating. Prefer it on small screens, inside dialogs, or anywhere an overlay could be clipped.</p>

      <div class="" style="max-inline-size: 22rem;">
  <details class="multiselect" data-variant="inline">
    <summary class="repel" data-nowrap>
      <span class="multiselect__label">Sizes</span>
    </summary>
    <fieldset class="multiselect__panel flow">
      <legend class="visually-hidden">Sizes</legend>
      <label class="multiselect__option">
        <input type="checkbox" name="size" value="s"> Small
      </label>
      <label class="multiselect__option">
        <input type="checkbox" name="size" value="m" checked> Medium
      </label>
      <label class="multiselect__option">
        <input type="checkbox" name="size" value="l" checked> Large
      </label>
      <p class="multiselect__status" aria-live="polite"></p>
    </fieldset>
  </details>
      </div>

      <details class="margin-y-s">
        <summary>Show code</summary>
        <pre class="padding-m"><code>  &lt;details class=&quot;multiselect&quot; data-variant=&quot;inline&quot;&gt;
    &lt;summary class=&quot;repel&quot; data-nowrap&gt;
