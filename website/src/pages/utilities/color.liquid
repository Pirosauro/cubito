{% layout "layouts/base.liquid" %}
{% block title %}Color — Cubito UI Docs{% endblock %}

{% block content %}
<article class="flow">

  <header class="flow" style="padding-block-end: var(--space-l); border-block-end: var(--border-s) solid var(--color-neutral-200);">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/utilities/">Utilities</a></li>
        <li aria-current="page">Color</li>
      </ol>
    </nav>
    <h1>Color</h1>
    <p class="text-m color-subtle">Convenience classes for applying colour tokens to text, backgrounds, and borders. All tokens are defined in the theme layer.</p>
  </header>

  <section>
    <div class="flow" style="--flow-space: var(--space-s);">
      <h2 class="heading-l">Text colour</h2>
      <p>Use <code>.color-{name}</code> to set the text colour of an element to a design token value.</p>
    
      <div class="">
  <div class="flow background-white" data-theme="light" style="color: var(--text); --flow-space: var(--space-xxs); padding: var(--space-s); border-radius: var(--border-radius-m)">
    <p class="color-brand">.color-brand</p>
    <p class="color-accent">.color-accent</p>
    <p class="color-status-ok">.color-status-ok</p>
    <p class="color-status-warning">.color-status-warning</p>
    <p class="color-status-ko">.color-status-ko</p>
    <p class="color-status-info">.color-status-info</p>
    <p class="color-neutral-500">.color-neutral-500</p>
    <p class="color-neutral-700">.color-neutral-700</p>
    <p class="color-neutral-900">.color-neutral-900</p>
  </div>
      </div>

      <details class="margin-y-s">
        <summary>Show code</summary>
        <pre class="padding-m"><code>&lt;div class=&quot;flow&quot; style=&quot;--flow-space: var(--space-xxs)&quot;&gt;
    &lt;p class=&quot;color-brand&quot;&gt;.color-brand&lt;/p&gt;
    &lt;p class=&quot;color-accent&quot;&gt;.color-accent&lt;/p&gt;
    &lt;p class=&quot;color-status-ok&quot;&gt;.color-status-ok&lt;/p&gt;
    &lt;p class=&quot;color-status-warning&quot;&gt;.color-status-warning&lt;/p&gt;
    &lt;p class=&quot;color-status-ko&quot;&gt;.color-status-ko&lt;/p&gt;
    &lt;p class=&quot;color-status-info&quot;&gt;.color-status-info&lt;/p&gt;
    &lt;p class=&quot;color-neutral-500&quot;&gt;.color-neutral-500&lt;/p&gt;
    &lt;p class=&quot;color-neutral-700&quot;&gt;.color-neutral-700&lt;/p&gt;
    &lt;p class=&quot;color-neutral-900&quot;&gt;.color-neutral-900&lt;/p&gt;
  &lt;/div&gt;</code></pre>
      </details>
  
    </div>
  </section>

  <section>
    <div class="flow" style="--flow-space: var(--space-s);">
      <h2 class="heading-l">Background colour</h2>
      <p>Use <code>.background-{name}</code> to set the background colour of an element.</p>
    
      <div class="">
  <div class="background-white" data-theme="light" style="color: var(--text); display: grid; grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr)); gap: var(--space-xs); padding: var(--space-s); border-radius: var(--border-radius-m)">
    <div class="background-brand" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-brand); font-size: var(--font-size-xs)">brand</div>
    <div class="background-accent" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-brand); font-size: var(--font-size-xs)">accent</div>
    <div class="background-status-ok" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)">status-ok</div>
    <div class="background-status-warning" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)">status-warning</div>
    <div class="background-status-ko" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)">status-ko</div>
    <div class="background-status-info" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)">status-info</div>
    <div class="background-neutral-100 border border-neutral-200" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">neutral-100</div>
    <div class="background-neutral-200" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">neutral-200</div>
    <div class="background-neutral-300" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">neutral-300</div>
    <div class="background-neutral-400" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-neutral-900); font-size: var(--font-size-xs)">neutral-400</div>
    <div class="background-neutral-500" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)">neutral-500</div>
    <div class="background-neutral-600" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)">neutral-600</div>
    <div class="background-neutral-700" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)">neutral-700</div>
    <div class="background-neutral-800" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)">neutral-800</div>
    <div class="background-neutral-900" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)">neutral-900</div>
    <div class="background-neutral-950" style="padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)">neutral-950</div>
  </div>
      </div>

      <details class="margin-y-s">
        <summary>Show code</summary>
        <pre class="padding-m"><code>&lt;div style=&quot;display: grid; grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr)); gap: var(--space-xs)&quot;&gt;
    &lt;div class=&quot;background-brand&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-brand); font-size: var(--font-size-xs)&quot;&gt;brand&lt;/div&gt;
    &lt;div class=&quot;background-accent&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-brand); font-size: var(--font-size-xs)&quot;&gt;accent&lt;/div&gt;
    &lt;div class=&quot;background-status-ok&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)&quot;&gt;status-ok&lt;/div&gt;
    &lt;div class=&quot;background-status-warning&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)&quot;&gt;status-warning&lt;/div&gt;
    &lt;div class=&quot;background-status-ko&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)&quot;&gt;status-ko&lt;/div&gt;
    &lt;div class=&quot;background-status-info&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-on-status); font-size: var(--font-size-xs)&quot;&gt;status-info&lt;/div&gt;
    &lt;div class=&quot;background-neutral-100 border border-neutral-200&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;neutral-100&lt;/div&gt;
    &lt;div class=&quot;background-neutral-200&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;neutral-200&lt;/div&gt;
    &lt;div class=&quot;background-neutral-300&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;neutral-300&lt;/div&gt;
    &lt;div class=&quot;background-neutral-400&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: var(--color-neutral-900); font-size: var(--font-size-xs)&quot;&gt;neutral-400&lt;/div&gt;
    &lt;div class=&quot;background-neutral-500&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)&quot;&gt;neutral-500&lt;/div&gt;
    &lt;div class=&quot;background-neutral-600&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)&quot;&gt;neutral-600&lt;/div&gt;
    &lt;div class=&quot;background-neutral-700&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)&quot;&gt;neutral-700&lt;/div&gt;
    &lt;div class=&quot;background-neutral-800&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)&quot;&gt;neutral-800&lt;/div&gt;
    &lt;div class=&quot;background-neutral-900&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)&quot;&gt;neutral-900&lt;/div&gt;
    &lt;div class=&quot;background-neutral-950&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); color: white; font-size: var(--font-size-xs)&quot;&gt;neutral-950&lt;/div&gt;
  &lt;/div&gt;</code></pre>
      </details>
  
    </div>
  </section>

  <section>
    <div class="flow" style="--flow-space: var(--space-s);">
      <h2 class="heading-l">Border colour</h2>
      <p>Use <code>.border-{name}</code> alongside a border-width utility (<code>.border-s</code>, <code>.border</code>, or <code>.border-l</code>) to apply a coloured border.</p>
    
      <div class="">
  <div style="display: flex; flex-wrap: wrap; gap: var(--space-s)">
    <div class="border border-brand" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-brand</div>
    <div class="border border-accent" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-accent</div>
    <div class="border border-status-ok" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-status-ok</div>
    <div class="border border-status-ko" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-status-ko</div>
    <div class="border border-neutral-300" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-neutral-300</div>
  </div>
      </div>

      <details class="margin-y-s">
        <summary>Show code</summary>
        <pre class="padding-m"><code>&lt;div style=&quot;display: flex; flex-wrap: wrap; gap: var(--space-s)&quot;&gt;
    &lt;div class=&quot;border border-brand&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;.border-brand&lt;/div&gt;
    &lt;div class=&quot;border border-accent&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;.border-accent&lt;/div&gt;
    &lt;div class=&quot;border border-status-ok&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;.border-status-ok&lt;/div&gt;
    &lt;div class=&quot;border border-status-ko&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;.border-status-ko&lt;/div&gt;
    &lt;div class=&quot;border border-neutral-300&quot; style=&quot;padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)&quot;&gt;.border-neutral-300&lt;/div&gt;
  &lt;/div&gt;</code></pre>
      </details>
  
    </div>
  </section>
  <section>
    <div class="flow" style="--flow-space: var(--space-s);">
      <h2 class="heading-l">Adaptive roles</h2>
      <p>The palette classes above are fixed: <code>.color-neutral-600</code> looks the same in the light and the dark theme. The role classes follow the active theme (<code>color-scheme</code> or <code>data-theme</code>), so prefer them for surfaces, text and borders.</p>

      <div class="">
  <div style="display: flex; flex-wrap: wrap; gap: var(--space-s)">
    <div class="background-surface border border-subtle" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.background-surface</div>
    <div class="background-subtle border border-subtle" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.background-subtle</div>
    <div class="background-sunken border border-subtle" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.background-sunken</div>
    <div class="background-strong" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.background-strong</div>
    <div class="background-inverse color-on-inverse" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.background-inverse .color-on-inverse</div>
  </div>
  <div class="flow" style="--flow-space: var(--space-xxs); margin-block-start: var(--space-s)">
    <p class="color-text">.color-text</p>
    <p class="color-muted">.color-muted</p>
    <p class="color-subtle">.color-subtle</p>
  </div>
  <div style="display: flex; flex-wrap: wrap; gap: var(--space-s); margin-block-start: var(--space-s)">
    <div class="border border-subtle" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-subtle</div>
    <div class="border border-default" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-default</div>
    <div class="border border-strong" style="padding: var(--space-s); border-radius: var(--border-radius-m); font-size: var(--font-size-xs)">.border-strong</div>
  </div>
      </div>

      <table>
        <thead>
          <tr><th>Class</th><th>Light</th><th>Dark</th></tr>
        </thead>
        <tbody>
          <tr><td><code>.background-surface</code></td><td>white</td><td>neutral-900</td></tr>
          <tr><td><code>.background-subtle</code></td><td>neutral-50</td><td>neutral-800</td></tr>
          <tr><td><code>.background-sunken</code></td><td>neutral-100</td><td>neutral-700</td></tr>
          <tr><td><code>.background-strong</code></td><td>neutral-200</td><td>neutral-600</td></tr>
          <tr><td><code>.background-inverse</code> + <code>.color-on-inverse</code></td><td>neutral-900 + neutral-50</td><td>neutral-50 + neutral-900</td></tr>
          <tr><td><code>.color-text</code></td><td>black</td><td>neutral-50</td></tr>
          <tr><td><code>.color-muted</code></td><td>neutral-500</td><td><code>#aaa</code></td></tr>
          <tr><td><code>.color-subtle</code></td><td>neutral-600</td><td>neutral-300</td></tr>
          <tr><td><code>.color-on-brand</code></td><td colspan="2"><code>--color-on-brand</code> — text for a <code>--color-brand</code> fill</td></tr>
          <tr><td><code>.border-subtle</code> / <code>-default</code> / <code>-strong</code></td><td>neutral-200 / -300 / -400</td><td>neutral-700 / -600 / -500</td></tr>
        </tbody>
      </table>
    </div>
  </section>

</article>
{% endblock %}
